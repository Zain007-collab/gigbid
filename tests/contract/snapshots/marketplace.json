{
  "create_proposal_draft": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": false
    },
    "inputSchema": {
      "$defs": {
        "ScreeningAnswerIn": {
          "properties": {
            "answer": {
              "maxLength": 3000,
              "minLength": 1,
              "title": "Answer",
              "type": "string"
            },
            "question": {
              "maxLength": 1000,
              "minLength": 1,
              "title": "Question",
              "type": "string"
            }
          },
          "required": [
            "question",
            "answer"
          ],
          "title": "ScreeningAnswerIn",
          "type": "object"
        }
      },
      "properties": {
        "approval_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Id of the human approval in GigBid. Required when dry_run is false.",
          "title": "Approval Id"
        },
        "bid_amount": {
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "Bid Amount",
          "type": "number"
        },
        "cover_letter": {
          "maxLength": 5000,
          "minLength": 50,
          "title": "Cover Letter",
          "type": "string"
        },
        "dry_run": {
          "default": true,
          "description": "True (default): return exactly what would be sent and what it costs; send nothing.",
          "title": "Dry Run",
          "type": "boolean"
        },
        "idempotency_key": {
          "description": "Stable per logical action (e.g. '<thread_id>:<node>:<n>'). Reusing it never repeats the write.",
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "job_id": {
          "description": "Marketplace job id, e.g. 'j_123'",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Job Id",
          "type": "string"
        },
        "rate_type": {
          "enum": [
            "fixed",
            "hourly"
          ],
          "title": "Rate Type",
          "type": "string"
        },
        "screening_answers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ScreeningAnswerIn"
          },
          "maxItems": 10,
          "title": "Screening Answers",
          "type": "array"
        }
      },
      "required": [
        "job_id",
        "cover_letter",
        "rate_type",
        "bid_amount",
        "idempotency_key"
      ],
      "title": "create_proposal_draftArguments",
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "Preview": {
          "properties": {
            "action": {
              "enum": [
                "create_proposal_draft",
                "submit_proposal",
                "send_message"
              ],
              "title": "Action",
              "type": "string"
            },
            "balance_after": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Balance After"
            },
            "connects_balance": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Connects Balance"
            },
            "connects_cost": {
              "minimum": 0,
              "title": "Connects Cost",
              "type": "integer"
            },
            "marketplace": {
              "title": "Marketplace",
              "type": "string"
            },
            "payload": {
              "additionalProperties": true,
              "description": "exactly what will be sent upstream",
              "title": "Payload",
              "type": "object"
            },
            "sufficient_connects": {
              "default": true,
              "title": "Sufficient Connects",
              "type": "boolean"
            }
          },
          "required": [
            "action",
            "payload",
            "connects_cost",
            "marketplace"
          ],
          "title": "Preview",
          "type": "object"
        }
      },
      "properties": {
        "action": {
          "enum": [
            "create_proposal_draft",
            "submit_proposal",
            "send_message"
          ],
          "title": "Action",
          "type": "string"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotency Key"
        },
        "preview": {
          "anyOf": [
            {
              "$ref": "#/$defs/Preview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "receipt": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Receipt"
        },
        "status": {
          "enum": [
            "dry_run",
            "done",
            "replayed"
          ],
          "title": "Status",
          "type": "string"
        },
        "trace_id": {
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "status",
        "action",
        "trace_id"
      ],
      "title": "WriteResult",
      "type": "object"
    }
  },
