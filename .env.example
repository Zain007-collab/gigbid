# ---- runtime selection --------------------------------------------------
GIGBID_PROFILE=open                # open | paid
MARKETPLACE_MODE=gigsim            # gigsim | upwork

# ---- hosted open-model providers (deployed `open` profile) -------------
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434

# ---- paid profile (optional) -------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- GigSim --------------------------------------------------------------
GIGSIM_BASE_URL=http://gigsim:8080
GIGSIM_API_KEY=

# ---- Upwork live mode (OAuth 2.1) ---------------------------------------
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
UPWORK_OAUTH_CLIENT_ID=
UPWORK_OAUTH_CLIENT_SECRET=
UPWORK_OAUTH_REDIRECT_URI=http://localhost:8000/auth/upwork/callback

# ---- our MCP servers ----------------------------------------------------
MARKETPLACE_MCP_URL=http://marketplace-mcp:8101/mcp
MARKETPLACE_SERVICE_TOKEN=         # bearer token the agent uses to call the marketplace server
MARKETPLACE_STATE_DB=/data/marketplace_state.sqlite3
PORTFOLIO_MCP_URL=http://portfolio-mcp:8102/mcp
WORKSPACE_MCP_URL=http://workspace-mcp:8103/mcp
WORKSPACE_SERVICE_TOKEN=
PORTFOLIO_SERVICE_TOKEN=
WORKSPACE_DB=/data/workspace.sqlite3
GITHUB_PERSONAL_ACCESS_TOKEN=      # read-only, public_repo scope

# ---- storage -------------------------------------------------------------
DATABASE_URL=postgresql://gigbid:gigbid@postgres:5432/gigbid
REDIS_URL=redis://redis:6379/0

# ---- security -----------------------------------------------------------
SESSION_SECRET=                    # 32+ random bytes
TOKEN_ENCRYPTION_KEY=              # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"

# ---- reviewer login (deployment) ------------------------------------------
REVIEWER_EMAIL=
REVIEWER_PASSWORD=

# ---- GigSim (our simulator) ---------------------------------------------
GIGSIM_ADMIN_TOKEN=                # protects /admin (chaos, tick, policy switch)
GIGSIM_POLICY_VERSION=1            # 2 = the 2 Nov platform policy update

# ---- tracing (one of) ---------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
