# GigBid environment template. Copy to .env and fill in values. NEVER put real values in this file:
# it is committed. .env is git-ignored. Comments stay on their own lines (an inline "# ..." after "=" is not a value).

# ---- runtime selection --------------------------------------------------
# open | paid
GIGBID_PROFILE=open
# gigsim | upwork
MARKETPLACE_MODE=gigsim

# ---- LLM providers (hosted open models for the deployed `open` profile) -
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# paid profile (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- deployment -----------------------------------------------------------
# Neon Postgres URL used by the deployed app (scripts/deploy_hf_space.sh sets it as the Space's DATABASE_URL).
DEPLOY_DATABASE_URL=
# Hugging Face write token for scripts/deploy_hf_space.sh
HF_TOKEN=
# Leave DATABASE_URL / REDIS_URL unset locally (SQLite + in-process worker); docker compose sets its own.
# DATABASE_URL=postgresql://gigbid:gigbid@localhost:5432/gigbid
# REDIS_URL=redis://localhost:6379/0

# ---- internal secrets (generate: python -c "import secrets;print(secrets.token_urlsafe(32))") ---
SESSION_SECRET=
# Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# protects GigSim /admin (chaos, tick, policy switch)
GIGSIM_ADMIN_TOKEN=
# bearer tokens the agents use to call our MCP servers over HTTP
MARKETPLACE_SERVICE_TOKEN=
PORTFOLIO_SERVICE_TOKEN=
WORKSPACE_SERVICE_TOKEN=

# ---- reviewer login for the live URL --------------------------------------
REVIEWER_EMAIL=
REVIEWER_PASSWORD=

# ---- GigSim (our simulator) ---------------------------------------------
# 2 = the 2 Nov platform policy update
GIGSIM_POLICY_VERSION=1
GIGSIM_API_KEY=

# ---- Upwork live mode (official MCP server, OAuth 2.1) ------------------
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
UPWORK_OAUTH_CLIENT_ID=
UPWORK_OAUTH_CLIENT_SECRET=
UPWORK_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/upwork/callback

# ---- third-party MCP: GitHub (read-only fine-grained PAT, public repos) ---
GITHUB_PERSONAL_ACCESS_TOKEN=

# ---- tracing (Langfuse Cloud or self-hosted) ------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
